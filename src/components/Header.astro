---
---

<header id="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Home">GDM<span>.</span></a>

    <div class="header-right">
      <nav aria-label="Main navigation">
        <a href="/#experience" class="nav-link" data-i18n="nav_experience">Experience</a>
        <a href="/#projects"   class="nav-link" data-i18n="nav_projects">Projects</a>
        <a href="/#about"      class="nav-link" data-i18n="nav_about">About</a>
        <a href="mailto:mendezgd88@gmail.com" class="nav-link" data-i18n="nav_contact">Contact</a>
      </nav>

      <!-- Language toggle -->
      <button id="lang-toggle" aria-label="Switch language" title="Switch language">
        <span id="lang-label">ES</span>
      </button>

      <!-- Theme toggle -->
      <button id="theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<style is:global>
  #site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 0 2rem;
    height: 60px;
    display: flex;
    align-items: center;
    background: transparent;
    transition: background 0.3s ease, border-bottom 0.3s ease;
  }

  #site-header.scrolled {
    background: rgba(245, 240, 232, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  html.dark #site-header.scrolled {
    background: rgba(20, 20, 18, 0.94);
  }

  #site-header .header-inner {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #site-header .logo {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  #site-header .logo:hover { opacity: 0.5; }

  #site-header .header-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  #site-header nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  #site-header .nav-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.2s;
    position: relative;
  }
  #site-header .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px; left: 0;
    width: 0; height: 1px;
    background: var(--ink);
    transition: width 0.25s ease;
  }
  #site-header .nav-link:hover { color: var(--ink); }
  #site-header .nav-link:hover::after { width: 100%; }

  /* Shared button style */
  #theme-toggle,
  #lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    cursor: pointer;
    color: var(--ink);
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    transition: background 0.2s, border-color 0.2s;
  }
  #theme-toggle:hover,
  #lang-toggle:hover {
    background: var(--border);
  }

  @media (max-width: 700px) {
    #site-header            { padding: 0 1.25rem; }
    #site-header .header-right { gap: 1rem; }
    #site-header nav        { gap: 1rem; }
    #site-header .nav-link  { font-size: 0.68rem; }
  }

  @media (max-width: 500px) {
    #site-header nav { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var header  = document.getElementById('site-header');
    var themBtn = document.getElementById('theme-toggle');
    var langBtn = document.getElementById('lang-toggle');
    var moonEl  = document.getElementById('icon-moon');
    var sunEl   = document.getElementById('icon-sun');
    var langLbl = document.getElementById('lang-label');

    // ── Theme ──────────────────────────────────────────
    function syncIcons() {
      var dark = document.documentElement.classList.contains('dark');
      if (moonEl) moonEl.style.display = dark ? 'none'  : 'block';
      if (sunEl)  sunEl.style.display  = dark ? 'block' : 'none';
    }
    syncIcons();

    if (themBtn) {
      themBtn.addEventListener('click', function () {
        var isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        syncIcons();
      });
    }

    // ── Scroll glass ───────────────────────────────────
    if (header) {
      window.addEventListener('scroll', function () {
        header.classList.toggle('scrolled', window.scrollY > 20);
      }, { passive: true });
    }

    // ── Language ───────────────────────────────────────
    function syncLangLabel() {
      var lang = localStorage.getItem('lang') || 'en';
      // Label shows the OTHER language (what you'll switch TO)
      if (langLbl) langLbl.textContent = lang === 'en' ? 'ES' : 'EN';
    }
    syncLangLabel();

    if (langBtn) {
      langBtn.addEventListener('click', function () {
        var current = localStorage.getItem('lang') || 'en';
        var next = current === 'en' ? 'es' : 'en';
        localStorage.setItem('lang', next);
        document.dispatchEvent(new CustomEvent('lang-change', { detail: next }));
        syncLangLabel();
      });
    }
  })();
</script>

---
const currentYear = new Date().getFullYear();
---

<footer
  class="opacity-80 m-4 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center"
  role="contentinfo"
>
  <div
    class="rounded-lg w-full max-w-screen-xl mx-auto md:flex md:items-center md:justify-between py-4"
  >
    <nav
      class="flex flex-wrap items-center mt-3 text-sm font-medium dark:text-white/90 sm:mt-0 m-3"
      aria-label="Footer navigation"
    >
      <ul class="flex flex-wrap items-center gap-4 md:gap-6">
        <li>
          <a href="/#proyectos" class="hover:underline" aria-label="Go to projects section">Projects</a>
        </li>
        <li>
          <a href="/#experiencia" class="hover:underline" aria-label="Go to experience section">Experience</a>
        </li>
        <li>
          <a
            id="contacto"
            href="mailto:mendezgd88@gmail.com"
            class="hover:underline"
            aria-label="Send email to Gustavo">Contact</a
          >
        </li>
      </ul>
    </nav>
    <div class="text-sm text-gray-600 dark:text-gray-400 mt-4 md:mt-0">
      <p>&copy; {currentYear} Gustavo D. Mendez. All rights reserved.</p>
    </div>
  </div>
</footer>

---

<div class="exp-list">
  {
    EXPERIENCE.map((item, i) => (
      <div class={`exp-item reveal reveal-delay-${Math.min((i % 3) + 1, 4)}`}>
        <div class="exp-date">
          <span class="date-en">{item.date_en}</span>
          <span class="date-es" style="display:none">
            {item.date_es}
          </span>
        </div>
        <div class="exp-body">
          <div class="exp-header">
            <span class="exp-title">
              <span class="title-en">{item.title_en}</span>
              <span class="title-es" style="display:none">
                {item.title_es}
              </span>
            </span>
            <span class="exp-company">{item.company}</span>
          </div>
          <p class="exp-desc">
            <span class="desc-en">{item.desc_en}</span>
            <span class="desc-es" style="display:none">
              {item.desc_es}
            </span>
          </p>
          {item.link && (
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="exp-link"
              data-i18n="exp_visit"
            >
              Visit site →
            </a>
          )}
        </div>
      </div>
    ))
  }
</div>

<style>
  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .exp-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 0 2.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }
  .exp-item:first-child {
    border-top: 1px solid var(--border);
  }
  .exp-date {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-ghost);
    text-transform: uppercase;
    padding-top: 0.2rem;
    white-space: nowrap;
  }
  .exp-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .exp-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  .exp-title {
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .exp-company {
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .exp-desc {
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 56ch;
  }
  .exp-link {
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--ink-ghost);
    transition: color 0.2s;
    width: fit-content;
  }
  .exp-link:hover {
    color: var(--ink);
  }
  @media (max-width: 680px) {
    .exp-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1.5rem 0;
    }
  }
</style>

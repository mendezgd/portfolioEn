---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCIE = [
  {
    date: " Jun 2025 - At present.",
    title: "Frontend Developer",
    company: "MM - Monica & Marcelo Building Administrators",
    description: "Creation and maintenance of the current website.",
  },
  {
    date: " Feb 2025 - At present.",
    title: "Frontend Developer",
    company: "Marlogistic",
    description: "Creation and maintenance of the current website.",
  },
  {
    date: " Jul 2023 - At present.",
    title: "Frontend Developer",
    company: "FyM Sanitarios",
    description:
      "Creation and maintenance of the current website and development of a new one focused on eCommerce using React (work in progress).",
  },
  {
    date: " Jul 2016 - At present.",
    title: "Help Desk Specialist",
    company: "Ribeiro",
    description:
      "Help Desk Specialist, Active Directory admin, Mail admin, Credit Cards homologation.",
  },
  {
    date: "Sep 2014 - Jul 2016. ",
    title: "IT Support at Atos for Siemens account LATAM",
    company: "Atos",
    description:
      "Assistance over the phone or ticket performing remote troubleshooting through diagnostic techniques for Siemens employees. Ticket tool BMC Remedy, Service Now, Net pro2000, Active Directory.",
  },
  {
    date: "Jul 2010 - Dec 2013. ",
    title: "IT Technician",
    company: "Microsoft",
    description:
      "HST IT Support Team Level 1 & 2. On site support, resolution of different hardware and software incidents, contact with suppliers (Lenovo, Xerox, HP), Hardware stock management.",
  },
];
---

<ol class="relative mt-16" itemscope itemtype="https://schema.org/Person">
  {
    EXPERIENCIE.map((experiencie) => (
      <li class="">
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Gustavo D. Mendez",
    jobTitle: "Frontend Developer",
    worksFor: EXPERIENCIE.map((exp) => ({
      "@type": "Organization",
      name: exp.company,
      employee: {
        "@type": "Person",
        name: "Gustavo D. Mendez",
        jobTitle: exp.title,
      },
    })),
    hasOccupation: EXPERIENCIE.map((exp) => ({
      "@type": "Occupation",
      name: exp.title,
      employerName: exp.company,
      description: exp.description,
    })),
  })}
/>

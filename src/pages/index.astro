---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Experience from "@/components/Experience.astro";
import Projects from "@/components/Projects.astro";
import AboutMe from "@/components/AboutMe.astro";
import Certificados from "@/components/Certificados.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Gustavo D. Mendez — Frontend Developer"
  description="Frontend Developer specializing in React, JavaScript, and modern web technologies. Based in Buenos Aires, Argentina."
  image="/perfil.webp"
  type="profile"
>
  <Header />

  <main>
    <Hero />

    <div class="page-content">

      <section id="experience" class="page-section">
        <div class="section-label reveal">
          <span class="label-num">01</span>
          <span class="label-text" data-i18n="sec_experience">Experience</span>
        </div>
        <Experience />
      </section>

      <section id="projects" class="page-section">
        <div class="section-label reveal">
          <span class="label-num">02</span>
          <span class="label-text" data-i18n="sec_projects">Projects</span>
        </div>
        <Projects />
      </section>

      <section id="about" class="page-section">
        <div class="section-label reveal">
          <span class="label-num">03</span>
          <span class="label-text" data-i18n="sec_about">About</span>
        </div>
        <AboutMe />
      </section>

      <section id="certificates" class="page-section">
        <div class="section-label reveal">
          <span class="label-num">04</span>
          <span class="label-text" data-i18n="sec_certificates">Certificates</span>
        </div>
        <Certificados />
      </section>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .page-section { padding: 6rem 0 0; }
  .section-label {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 3rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .label-num  { font-size: 0.65rem; letter-spacing: 0.1em; color: var(--ink-ghost); font-weight: 500; }
  .label-text { font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); font-weight: 500; }
  @media (max-width: 600px) {
    .page-content { padding: 0 1.25rem; }
    .page-section { padding-top: 4rem; }
  }
</style>

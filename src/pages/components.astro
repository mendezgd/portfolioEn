---
import Badge from "@/components/Badge.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import SocialPill from "@/components/SocialPill.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import Layout from "@/layouts/Layout.astro"

const seoData = {
  title: "Design System & Components | Gustavo D. Mendez Portfolio",
  description: "Explore the design system and reusable components used in my portfolio. Built with Astro, Tailwind CSS, and modern web technologies.",
  keywords: "design system, components, astro, tailwind css, portfolio components, web design",
  type: "website"
};
---

<Layout
  title={seoData.title}
  description={seoData.description}
  type={seoData.type}
>
  <SectionContainer class="py-44 pb-32 flex flex-col gap-y-10">
    <article class="mb-10">
      <h1 class="mb-4 text-xl font-semibold">&lt;Badge /&gt;</h1>

      <Badge>Available to work</Badge>
    </article>

    <article class="mb-10">
      <h1 class="mb-4 text-xl font-semibold">&lt SocialPill /&gt;</h1>

      <div class="flex">
        <SocialPill href="https://www.linkedin.com/in/gmendez1988">
          <LinkedInIcon class="size-4 md:size-6" />
          LinkedIn
        </SocialPill>
      </div>
    </article>
  </SectionContainer>
</Layout>
